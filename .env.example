
# ==================================================
# CrewAI Local and Cloud Deployment Configuration
# ==================================================
# Copy this file to .env and replace the placeholders.
# Never commit your actual .env file to GitHub.

# LLM API key (required for the local workflow)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# CrewAI Cloud deployment URL
CREWAI_CLOUD_URL=https://YOUR-DEPLOYMENT.crewai.com

# CrewAI Cloud Bearer Token, not User Bearer Token
CREWAI_BEARER_TOKEN=YOUR_CREWAI_BEARER_TOKEN

# Execution mode: local or cloud
CREWAI_EXECUTION_MODE=cloud
